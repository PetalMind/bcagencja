rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // --- Pomocnicze funkcje ---
    function isAuthenticated() {
      return request.auth != null;
    }
    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }
    function isAdmin() {
      return isAuthenticated()
        && exists(/databases/$(database)/documents/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    // --- users: profil użytkownika ---
    // Odczyt: własny dokument lub admin. Zapis własnego: tylko swój uid. Aktualizacja: własny lub admin.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) || isAdmin();
      allow delete: if isAdmin();
    }
    // Ostatnio oglądane oferty (dokument np. recently_viewed w preferences).
    match /users/{userId}/preferences/{docId} {
      allow read, write: if isOwner(userId);
    }

    // --- ndaAcceptanceLogs: logi akceptacji NDA ---
    // Tylko zalogowany użytkownik może dodać wpis (add). Odczyt tylko admin (opcjonalnie).
    match /ndaAcceptanceLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    // --- inviteTokens: tokeny zaproszeń (link do rejestracji Agent/Dyrektor) ---
    // Odczyt bez auth, żeby strona rejestracji z linku mogła pobrać dane po tokenie (doc id = token).
    // Update: zalogowany użytkownik może oznaczyć token jako użyty po rejestracji.
    match /inviteTokens/{tokenId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // --- listing_submissions: zgłoszenia "Chcę sprzedać" ---
    // Tworzenie: zalogowany użytkownik.
    // Odczyt: admin (wszystkie), właściciel (własne), lub każdy – dokumenty ze statusem pending/published (widok Baza ofert).
    // Aktualizacja (status, przypisanie): tylko admin.
    match /listing_submissions/{submissionId} {
      allow read: if isAdmin()
        || (isAuthenticated() && resource.data.submittedByUid == request.auth.uid)
        || resource.data.status == 'pending'
        || resource.data.status == 'published';
      allow update: if isAdmin();
      allow create: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // --- document_downloads: logi pobrań dokumentów (panel admina) ---
    // Tworzenie tylko z Cloud Function (getDocumentWithWatermark); klient nie pisze.
    match /document_downloads/{logId} {
      allow read: if isAdmin();
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // --- listings: oferty nieruchomości ---
    // Odczyt: admin (wszystkie), każdy (status == 'published'), lub właściciel (ownerId == uid).
    // Zapis: agent/dyrektor/admin (wg polityki biznesowej).
    match /listings/{listingId} {
      allow read: if isAdmin()
        || resource.data.status == 'published'
        || resource.data.ownerId == request.auth.uid;
      allow create, update, delete: if isAuthenticated();
    }

    // --- notifications: powiadomienia dla użytkowników (np. agent – oferta udostępniona) ---
    // Tworzenie: admin (np. przy „Udostępnij do sprzedaży”). Odczyt/update: tylko własne (userId == request.auth.uid).
    match /notifications/{notificationId} {
      allow read, update: if isAuthenticated() && resource.data.userId == request.auth.uid;
      allow create: if isAdmin();
      allow delete: if isAdmin() || (isAuthenticated() && resource.data.userId == request.auth.uid);
    }
  }
}
