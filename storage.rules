rules_version = '2';

// Firebase Storage – załączniki zgłoszeń "Chcę sprzedać".
// Upload: zalogowany użytkownik (w tym anonimowy) do własnego katalogu listing_submissions/{userId}/
// Odczyt: zalogowani użytkownicy (admin/agent pobiera pliki z panelu – wymaga auth).
service firebase.storage {
  match /b/{bucket}/o {
    match /listing_submissions/{userId}/{allPaths=**} {
      // Zapis: tylko właściciel katalogu (uid == userId)
      allow write: if request.auth != null && request.auth.uid == userId;
      // Odczyt: zalogowani użytkownicy (panel admina/agenta)
      allow read: if request.auth != null;
    }
    match /avatars/{fileName} {
      // Zdjęcie profilowe (avatars/{uid}.jpg): zapis tylko przez właściciela
      allow write: if request.auth != null && fileName == request.auth.uid + '.jpg';
      allow read: if true;
    }
  }
}
